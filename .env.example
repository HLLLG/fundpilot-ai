# FundPilot AI — copy to .env and set secrets in the first block

# Secrets & paths
FUND_AI_JWT_SECRET=fundpilot-dev-jwt-secret-change-me-32chars
# FUND_AI_DATABASE_URL=mysql://user:pass@host:3306/fundpilot
# 本地开发/测试请留空，使用 SQLite；生产 Lighthouse 填写内网 MySQL 连接串
# 因子 IC 快照发布：生产 Lighthouse 与 GitHub Secret 使用同一个随机 Token
FUND_AI_FACTOR_IC_PUBLISH_TOKEN=
FUND_AI_FACTOR_IC_STALE_AFTER_DAYS=30
# 决策质量最新快照只读接口使用独立随机 Token（禁止复用 JWT/发布 Token）
FUND_AI_DECISION_QUALITY_READ_TOKEN=
# D5 配对 Prompt shadow 的 HMAC 分流密钥；仅在显式启用时填写，禁止提交或复用其他密钥
FUND_AI_PROMPT_SHADOW_ASSIGNMENT_SECRET=
# FUND_AI_APP_ENV=production
FUND_AI_DEEPSEEK_API_KEY=
# FUND_AI_DB_PATH=
# 从线上 MySQL 复制一份到本地：python scripts/migrate_mysql_to_sqlite.py --force
# 然后设 FUND_AI_DATABASE_URL= 且 FUND_AI_DB_PATH=data/app-from-prod.db
# FUND_AI_UPLOAD_DIR=
FUND_AI_DB_AUTO_IMPORT_PATH=
# Optional VPS relay: http://host:8787/boards (also serves /kline/daily for backtest)
FUND_AI_SECTOR_QUOTES_RELAY_URL=
FUND_AI_SECTOR_QUOTES_RELAY_TOKEN=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# 生产 nginx 镜像。留空 = 官方 nginx:1.27-alpine。
# 留空时站点已经受益于构建期预压缩：server 段的 `gzip_static on` 会直发
# apps/web 构建产出的同名 .gz（gzip -9），不再每请求现压 level 5。
#
# 设为 `fundpilot-nginx:<tag>` 时，deploy.sh 会用 deploy/nginx/Dockerfile 自建
# 带 ngx_brotli 的镜像，静态与 HTML location 自动升级为直发 .br：
# 首屏传输实测 gzip -9 171.1 KiB -> brotli q11 143.2 KiB（-16.3%）。
# 站点配置对两种镜像都安全（fundpilot.conf 用 glob include，官方镜像下匹配不到
# 文件即空操作）；镜像构建期会断言 brotli / gzip_static 均可用，部署脚本还会在
# 替换前端根目录**之前**用真实站点配置跑一次 `nginx -t`，失败即中止、站点不受影响。
# 首次启用建议先在服务器上手动跑一次：
#   docker build -f deploy/nginx/Dockerfile -t fundpilot-nginx:brotli deploy/nginx
FUND_AI_NGINX_IMAGE=

# App defaults
# Uvicorn worker processes. The 3.6G Lighthouse host stays at 1; daily-report
# and discovery SSE still share in-process thread pools. Raise only when the
# box has enough RAM for a second spawned interpreter.
WEB_CONCURRENCY=1
# Local direct API startup keeps ``all`` for one-command convenience. The
# production Compose file overrides API=request-only and worker=jobs-only.
FUND_AI_RUNTIME_ROLE=all
FUND_AI_BACKGROUND_WORKER_LOCK_TIMEOUT_SECONDS=5
FUND_AI_BACKGROUND_WORKER_RETRY_SECONDS=5
FUND_AI_BACKGROUND_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
FUND_AI_BACKGROUND_WORKER_HEARTBEAT_STALE_SECONDS=45
FUND_AI_ASYNC_JOB_MAX_WORKERS=2
FUND_AI_ASYNC_JOB_QUEUE_CAPACITY=8
FUND_AI_ASYNC_JOB_HEARTBEAT_INTERVAL_SECONDS=15
FUND_AI_ASYNC_JOB_STALE_SECONDS=900
FUND_AI_ASYNC_JOB_RETRY_AFTER_SECONDS=5
# 每个 API 进程最多同时承载的深度 SSE；超限立即 429 + Retry-After。
FUND_AI_SSE_MAX_CONCURRENT_PER_PROCESS=4
FUND_AI_SSE_RETRY_AFTER_SECONDS=5
FUND_AI_SSE_SHARED_IO_WORKERS=32
FUND_AI_SSE_ANALYSIS_CONTEXT_WORKERS=2
FUND_AI_SSE_DISCOVERY_CONTEXT_WORKERS=2
FUND_AI_STREAM_SESSION_TTL_SECONDS=7200
FUND_AI_MYSQL_CONNECTION_MAX_LIFETIME_SECONDS=1800
FUND_AI_MYSQL_CONNECTION_MAX_REUSE_COUNT=500
FUND_AI_MYSQL_SESSION_WAIT_TIMEOUT_SECONDS=2100
FUND_AI_MYSQL_DEDICATED_SESSION_POOL_SIZE=2
FUND_AI_MYSQL_DEDICATED_SESSION_ACQUIRE_TIMEOUT_SECONDS=30
FUND_AI_FUND_PROFILE_CACHE_TTL_SECONDS=5
FUND_AI_AKSHARE_WORKER_POOL_SIZE=2
FUND_AI_AKSHARE_WORKER_MAX_TASKS=50
FUND_AI_AKSHARE_WORKER_MAX_LIFETIME_SECONDS=1800
FUND_AI_AKSHARE_WORKER_ACQUIRE_TIMEOUT_SECONDS=10
FUND_AI_PERFORMANCE_METRICS_ENABLED=true
FUND_AI_PERFORMANCE_SAMPLE_SIZE=2048
FUND_AI_PERFORMANCE_SLOW_REQUEST_MS=1000
FUND_AI_PERFORMANCE_LOG_SAMPLE_RATE=0.01
# 运维监控面板（/admin/ops）：错误堆栈与流量/延迟按分钟持久化，供报错排查使用。
FUND_AI_OPS_ERROR_CAPTURE_ENABLED=true
FUND_AI_OPS_TRAFFIC_CAPTURE_ENABLED=true
# 浏览器错误上报入口无需登录（登录页崩溃也要能上报），遭遇滥用时可置 false 止血。
FUND_AI_OPS_CLIENT_ERROR_INGEST_ENABLED=true
FUND_AI_OPS_ERROR_RETENTION_DAYS=14
FUND_AI_OPS_TRAFFIC_RETENTION_DAYS=14
# sector_spot_cache / news_cache / ocr_text_cache 过期行不会在读取时删除，按 updated_at 清理。
FUND_AI_SPOT_CACHE_RETENTION_DAYS=14
FUND_AI_OPS_ERROR_EVENTS_PER_FINGERPRINT_PER_MINUTE=20
FUND_AI_OPS_CLIENT_ERROR_RATE_LIMIT_PER_MINUTE=60
FUND_AI_OPS_CLIENT_ERROR_GLOBAL_RATE_LIMIT_PER_MINUTE=1200
# 追问 / 日报 Job / 荐基 Job 的 LangGraph 编排。关闭后回线性实现，不改仓位与质量门。
FUND_AI_LANGGRAPH_ENABLED=true
FUND_AI_LANGGRAPH_RUN_RETENTION_DAYS=14
FUND_AI_STARTUP_BOOTSTRAP_BACKGROUND=true
FUND_AI_EASTMONEY_CALL_DEADLINE_SECONDS=30
FUND_AI_EASTMONEY_MAX_CONCURRENCY=8
FUND_AI_EASTMONEY_ACQUIRE_TIMEOUT_SECONDS=5
FUND_AI_EASTMONEY_CIRCUIT_FAILURE_THRESHOLD=3
FUND_AI_EASTMONEY_CIRCUIT_COOLDOWN_SECONDS=15
# 留空使用系统临时目录；生产 Compose 会覆盖为共享数据卷路径
FUND_AI_BACKGROUND_WORKER_HEARTBEAT_PATH=
FUND_AI_JWT_ACCESS_EXPIRE_MINUTES=43200
FUND_AI_PORTFOLIO_MUTATION_LOCK_TIMEOUT_SECONDS=30
# MySQL defaults this to false for cross-worker correctness. Only enable when a
# shared cache-version mechanism is introduced; process memory is not shared.
# FUND_AI_HOLDINGS_MEMORY_CACHE_ENABLED=false

# D5 配对 Prompt shadow：默认关闭；挑战者只后台运行，不改变用户看到的冠军报告。
# 10000 basis points = 100%；实际调用仍受上海自然日全局上限约束。
FUND_AI_PROMPT_SHADOW_ENABLED=false
FUND_AI_PROMPT_SHADOW_ASSIGNMENT_KEY_ID=prompt-shadow-assignment-v1
FUND_AI_PROMPT_SHADOW_SAMPLE_BASIS_POINTS=10000
FUND_AI_PROMPT_SHADOW_MAX_CHALLENGER_CALLS_PER_DAY=100
FUND_AI_PROMPT_SHADOW_WORKER_BATCH_SIZE=8
FUND_AI_PROMPT_SHADOW_LEASE_SECONDS=180
FUND_AI_PROMPT_SHADOW_CHALLENGER_DEADLINE_SECONDS=900

FUND_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
FUND_AI_DEEPSEEK_MODEL=deepseek-v4-pro
FUND_AI_DEEPSEEK_MODEL_FAST=deepseek-v4-flash
FUND_AI_DEEPSEEK_TIMEOUT_SECONDS=300
FUND_AI_DEEPSEEK_REQUEST_BUDGET_SECONDS=180
FUND_AI_DEEPSEEK_FIRST_BYTE_TIMEOUT_SECONDS=60
FUND_AI_DEEPSEEK_MAX_TOKENS=32768
FUND_AI_DEEPSEEK_MAX_TOKENS_REPORT=16384
FUND_AI_DEEPSEEK_CONNECTION_RETRIES=2
# 日报与发现基金可以同时占一条 DeepSeek 长流；设为 1 会让后到的那条在排队里
# 耗尽 180s 预算，再被心跳误标成整条 SSE 断开。
FUND_AI_DEEPSEEK_MAX_CONCURRENT_STREAMS=2
FUND_AI_DEEPSEEK_MAX_CONCURRENT_REQUESTS=3
FUND_AI_DEEPSEEK_STREAM_ACQUIRE_TIMEOUT_SECONDS=180
FUND_AI_DEEPSEEK_ACQUIRE_TIMEOUT_SECONDS=45

FUND_AI_NEWS_ENABLED=true
FUND_AI_NEWS_MAX_TOPICS=5
FUND_AI_NEWS_PER_TOPIC=5
# 兼容预留：这里只记录 configured rounds；主报告生成链未挂载自主工具，executed rounds 为 0
FUND_AI_NEWS_TOOL_MAX_ROUNDS=3
FUND_AI_NEWS_SOURCES=eastmoney,cls,announcement,macro
FUND_AI_NEWS_SUMMARIZE=true
FUND_AI_NEWS_SUMMARIZE_MODEL=
FUND_AI_NEWS_SUMMARIZE_MAX_POINTS=5
FUND_AI_NEWS_SUMMARIZE_TIMEOUT_SECONDS=60
FUND_AI_NEWS_FETCH_TIMEOUT_SECONDS=20
FUND_AI_NEWS_PREFETCH_TOTAL_TIMEOUT_SECONDS=45
# 基金公告独立预取：不占 NEWS_MAX_TOPICS；缓存 TTL 默认 6 小时
FUND_AI_NEWS_ANNOUNCEMENT_MAX_FUNDS=20
FUND_AI_NEWS_ANNOUNCEMENT_PER_FUND=3
FUND_AI_NEWS_ANNOUNCEMENT_CACHE_TTL_SECONDS=21600
FUND_AI_NEWS_ANNOUNCEMENT_PREFETCH_TOTAL_TIMEOUT_SECONDS=20
# Phase B：全市场申购状态短缓存 + 份额费率规则日级缓存。
FUND_AI_FUND_TRADEABILITY_STATUS_CACHE_TTL_SECONDS=900
FUND_AI_FUND_TRADEABILITY_FEE_CACHE_TTL_SECONDS=86400
FUND_AI_FUND_TRADEABILITY_STATUS_TIMEOUT_SECONDS=20
FUND_AI_FUND_TRADEABILITY_FEE_TIMEOUT_SECONDS=30
FUND_AI_FUND_TRADEABILITY_CURRENT_WINDOW_SECONDS=600
# Phase C: PIT holdings snapshot/look-through context. Deep mode may refresh
# current aging/stale disclosures; fast mode reads the append-only store only.
FUND_AI_FUND_HOLDINGS_CONTEXT_MAX_FUNDS=40
FUND_AI_FUND_HOLDINGS_CONTEXT_LIVE_MAX_FUNDS=8
FUND_AI_FUND_HOLDINGS_CONTEXT_WORKERS=4
FUND_AI_FUND_HOLDINGS_CONTEXT_TOTAL_TIMEOUT_SECONDS=18
FUND_AI_FUND_HOLDINGS_CONTEXT_FAST_TIMEOUT_SECONDS=2
FUND_AI_FUND_HOLDINGS_REFRESH_CHECK_TTL_SECONDS=21600
FUND_AI_FUND_HOLDINGS_REFRESH_RETRY_TTL_SECONDS=900
# 全市场基金代码→板块身份：首次启动连续回填，完成后仅刷新到期记录。
# 每批 800 只，内部按 80 只/子进程、最多 6 个上游请求并发；不要把名称匹配当 verified。
FUND_AI_FUND_PRIMARY_SECTOR_GLOBAL_ENABLED=true
FUND_AI_FUND_PRIMARY_SECTOR_PRECOMPUTE_ENABLED=true
FUND_AI_FUND_PRIMARY_SECTOR_PRECOMPUTE_BATCH_SIZE=800
FUND_AI_FUND_PRIMARY_SECTOR_PRECOMPUTE_PROFILE_CHUNK_SIZE=80
FUND_AI_FUND_PRIMARY_SECTOR_PRECOMPUTE_HOLDINGS_BATCH_SIZE=32
FUND_AI_FUND_PRIMARY_SECTOR_PRECOMPUTE_HOLDINGS_WORKERS=4
FUND_AI_FUND_PRIMARY_SECTOR_PRECOMPUTE_HOLDINGS_BACKFILL_PAUSE_SECONDS=30
FUND_AI_FUND_PRIMARY_SECTOR_PRECOMPUTE_INTERVAL_HOURS=6
FUND_AI_FUND_PRIMARY_SECTOR_PRECOMPUTE_STARTUP_DELAY_SECONDS=60
FUND_AI_FUND_PRIMARY_SECTOR_PRECOMPUTE_BACKFILL_PAUSE_SECONDS=5
FUND_AI_FUND_PRIMARY_SECTOR_PRECOMPUTE_UNAVAILABLE_RETRY_HOURS=6
FUND_AI_FUND_PRIMARY_SECTOR_PRECOMPUTE_PENDING_RETRY_DAYS=14
FUND_AI_FUND_PRIMARY_SECTOR_PRECOMPUTE_RESEARCH_RETRY_DAYS=30
FUND_AI_FUND_PRIMARY_SECTOR_PRECOMPUTE_UNMAPPED_RETRY_DAYS=30
FUND_AI_NEWS_MACRO_TOPIC=上证指数
FUND_AI_NEWS_REQUIRE_TODAY_FOR_ADD=true

FUND_AI_TACTICAL_PROMPT_TUNING_ENABLED=false
FUND_AI_TACTICAL_PROMPT_TUNING_LOOKBACK_REPORTS=30
FUND_AI_SECTOR_SIGNAL_BACKTEST_ENABLED=true
FUND_AI_SECTOR_SIGNAL_BACKTEST_DAYS=120
FUND_AI_SECTOR_SIGNAL_BACKTEST_MIN_TRIGGERS=10

FUND_AI_NAV_TREND_DAYS=66
FUND_AI_NAV_TREND_RECENT_SAMPLE=8

FUND_AI_SECTOR_QUOTES_ENABLED=true
FUND_AI_SECTOR_QUOTES_TTL_SECONDS=240
FUND_AI_SECTOR_QUOTES_RESPECT_MANUAL=false
FUND_AI_SECTOR_QUOTES_DISCREPANCY_WARN=0.5
FUND_AI_SECTOR_QUOTES_AUTO_INTERVAL_SECONDS=180
FUND_AI_SECTOR_QUOTES_RELAY_TIMEOUT_SECONDS=2.5
FUND_AI_SECTOR_QUOTES_BROWSER_ENABLED=false
FUND_AI_SECTOR_QUOTES_BROWSER_COMMAND=node scripts/sector-quote-browser-command.mjs
FUND_AI_SECTOR_QUOTES_BROWSER_TIMEOUT_SECONDS=20
FUND_AI_SECTOR_INTRADAY_BROWSER_COMMAND=node scripts/sector-intraday-browser-command.mjs

# 组合风险指标无风险利率（年化，小数；默认 0.02 = 2%，用于夏普/索提诺/Alpha）
FUND_AI_RISK_FREE_RATE=0.02

# 大盘情绪温度计（M1.1）：新高/新低家数可回测校准 + 涨跌停/炸板当日快照 + 沪市两融环比
FUND_AI_MARKET_BREADTH_ENABLED=true
FUND_AI_MARKET_BREADTH_TIMEOUT_SECONDS=4.0
# 基金涨跌分布后台预热（请求路径始终只读缓存）
FUND_AI_FUND_RETURN_DISTRIBUTION_REFRESH_ENABLED=true
# 量价背离信号回测（M1.3）
FUND_AI_FLOW_DIVERGENCE_BACKTEST_ENABLED=true
# 双向 guard 生效开关（M6）：enforced=升级判定真正改写动作、放出"大幅减仓评估/清仓
# 评估"动作词、并在深度模式启用二次 LLM 审校（每份报告多一次模型调用）。
# 灰度期已结束，默认 enforced；设为 shadow 可回滚成"只提示不生效"。
FUND_AI_DECISION_ESCALATION_MODE=enforced
# 日报确定性动作提议：决定"谁是决策来源"。
# enforced（默认）=方向成熟度/量化证据/风险与交易门禁全部通过、而结论仍停在"观察/暂停追涨"
#                  时，系统把它抬到"分批加仓"（比例仍由服务端标定档位算）。
# shadow         =提议照算但只写进 validation_notes，最终动作仍以模型草案为准（回滚用）。
# 它只会让被动结论变积极，绝不覆盖任何风险动作，也不绕过任何门禁。
# 分歧留痕见 analysis_facts.daily_action_proposal（mode / divergence_count / by_fund）。
FUND_AI_DAILY_ACTION_PROPOSAL_MODE=enforced

# 主题板块（市场 Tab）后台刷新：daemon 线程时段感知，前台只读缓存
FUND_AI_THEME_BOARD_REFRESH_ENABLED=true
FUND_AI_THEME_BOARD_REFRESH_INTERVAL_SECONDS=1200
# 非 A 股/美股活跃时段：每 3h 后台静默刷新共享市场缓存
FUND_AI_MARKET_SHARED_IDLE_INTERVAL_SECONDS=10800
FUND_AI_THEME_BOARD_REFRESH_IDLE_INTERVAL_SECONDS=10800
# 持仓详情按用户内存缓存 TTL（秒）；后台预热持仓关联板块分时/净值/详情
FUND_AI_HOLDING_DETAIL_CACHE_TTL_SECONDS=300
FUND_AI_HOLDING_INTRADAY_WARMUP_ENABLED=true

FUND_AI_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# 可选：正则匹配额外 Origin。生产同源部署通常不需要。
# FUND_AI_CORS_ORIGIN_REGEX=

# 本地开发：远程 MySQL 不可达时自动回退 SQLite（生产环境请设为 false）
FUND_AI_DB_FALLBACK_SQLITE=true
# 多进程同时启动时等待另一个进程完成 MySQL schema bootstrap 的上限（秒）
FUND_AI_MYSQL_SCHEMA_LOCK_TIMEOUT_SECONDS=60

# 启动时预取基金名称全集供 OCR/模糊查码；受限网络或纯 API 测试可关闭
FUND_AI_FUND_NAME_PRELOAD_ENABLED=true
# 搜索热门建议源的单次等待上限（秒）；失败时立即降级为本地匹配排序
FUND_AI_FUND_SEARCH_SUGGEST_TIMEOUT_SECONDS=1.2
# 截图识别只走云端 qwen-vl-ocr。本地 PaddleOCR 兜底已删除：它冷加载 + CPU 推理比云端慢
# 一个数量级，却会在云端出错时静默接管，把一次报错变成一次 60 秒超时。
# 阿里云百炼(DashScope) API Key；未配置时截图识别不可用，前端提示改用手动输入（截图会发往该 API）
FUND_AI_VLM_OCR_API_KEY=
FUND_AI_VLM_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 文字识别专用模型 qwen-vl-ocr（稳定版，基于 Qwen3-VL，便宜）；可切 qwen-vl-ocr-latest / qwen3.5-ocr
FUND_AI_VLM_OCR_MODEL=qwen-vl-ocr
# 读超时；实测单次识别 2.5~3.7s，15s 已是 4 倍余量
FUND_AI_VLM_OCR_TIMEOUT_SECONDS=15
# 图像缩放（控制 token，每 1024 像素≈1 图像 token）；min/max_pixels 作为 image_url 同级字段传入
FUND_AI_VLM_OCR_MIN_PIXELS=3072
# 2.0M 是实测保准确率的下界：12 只基金的长截图在 2.0M 仍全对，降到 1.2M 开始认错字
FUND_AI_VLM_OCR_MAX_PIXELS=2000000
# 上传前压缩（best-effort）：转 JPEG 减小上传体积/延迟；不影响 token（token 由 max_pixels 控制）
FUND_AI_VLM_OCR_COMPRESS_ENABLED=true
FUND_AI_VLM_OCR_JPEG_QUALITY=80
# 仅当图片最长边超过该像素才等比缩小（0 表示不缩放）；优先保准确度
FUND_AI_VLM_OCR_MAX_IMAGE_SIDE=1600
